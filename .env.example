INSTAGRAM_USERNAME=your_username
BROWSER_MODE=persistent
CHROME_USER_DATA_DIR=work/chrome-automation-profile
CHROME_PROFILE_DIR=Default
CHROME_REMOTE_DEBUGGING_PORT=9222
CHROME_REMOTE_DEBUGGING_URL=
DAILY_MAX_UNFOLLOWS=10
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=90
BATCH_SIZE=10
BATCH_COOLDOWN_MINUTES=10
BATCH_COOLDOWN_MAX_MINUTES=20
ALLOWLIST_PATH=config/allowlist.txt
STATE_PATH=config/state.json
LOG_DIR=logs
SCREENSHOT_DIR=screenshots
REPORT_DIR=reports
DEBUG=0
DRY_RUN=1
SKIP_PERSONAL_ACCOUNTS=1
PREFER_RECENT_FOLLOWS=1
CLEANUP_MODE=categories
CLEANUP_CATEGORIES=instagram_business_or_creator_category,selling_or_product_page,public_or_general_page
REDACT_USERNAMES=1
START_URL=https://www.instagram.com
FOLLOWING_URL=
SCROLL_PAUSE_MIN_SECONDS=2
SCROLL_PAUSE_MAX_SECONDS=5
